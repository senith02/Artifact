flowchart TB
    subgraph EV["Evidence pipeline (offline)"]
        direction TB
        data["Data loader<br/>jobs → builds"] --> features["Characteristic extractor<br/>28 features, 6 families,<br/>forbidden-field list"]
        features --> splits["Project split<br/>by project, in time order"]
        features --> dur["Duration estimator<br/>project history or regressor"]
        dur --> models["Failure models<br/>train + calibrate"]
        models --> abl["Added-value statistics<br/>paired bootstrap"]
        abl --> adm["Admission rule"]
        adm --> fit["Policy fitting"]
    end
    subgraph CORE["Decision core"]
        direction TB
        elig["Eligibility rules"] --> pol["Decision function decide()<br/>+ policy loader"]
        carb["Carbon lookup<br/>cleanest hour in window"] --> pol
    end
    acc["Energy + carbon accounting<br/>(never imported by decision modules)"]
    subgraph EVAL["Evaluation"]
        sim["Replay simulator"]
    end
    subgraph PROTO["Prototype"]
        direction TB
        cli["CLI + GitHub Action"] --> adv["Advisor"]
        api["REST API"] --> adv
        wif["What-If report"] --> adv
    end
    features -. "forbidden-field list" .-> pol
    fit --> sim
    sim --> pol
    sim --> acc
    adv --> pol
    adv --> dur
    adv -. "after the decision,<br/>display only" .-> acc
    wif --> acc
